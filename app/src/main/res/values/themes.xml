<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Full-screen backdrop behind the tiled windows: the home-screen wallpaper with see-through
        system bars, no window animation.
    -->
    <style name="Theme.TriSplit.Backdrop" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
